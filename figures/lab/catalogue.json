      "lab": "chemistry",
      "summary": "A 250 mL glass beaker for holding, mixing and heating liquids. Its marks are only approximate.",
      "safeUse": [
        "Carry it with one hand under the base, not by the rim.",
        "When you heat it, fill it to 150 mL at most, so it cannot boil over.",
        "Heat it on a hot plate or on a gauze over a tripod, never straight in a flame.",
        "Use a measuring cylinder or pipette when the volume matters.",
        "Let hot glass cool before you touch it: hot glass looks the same as cold glass."
      ],
      "mistakes": [
        {
          "id": "heating-empty",
          "when": "The hot plate is on and the beaker is empty.",
          "say": "The beaker is empty on a hot plate: heating dry glass can crack it. Turn the plate off."
        },
        {
          "id": "heating-too-full",
          "when": "The hot plate is on with more than 150 mL in the beaker.",
          "say": "That is too full to heat: it can boil over. Pour some out first."
        },
        {
          "id": "overfilled",
          "when": "The beaker holds more than its 250 mL mark.",
          "say": "The beaker is filled past 250 mL: it will spill when you carry it."
