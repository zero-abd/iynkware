      "id": "bunsen-burner",
      "kind": "lab",
      "name": "Bunsen burner",
      "page": "public/figures/lab/bunsen-burner.html",
      "lab": "chemistry",
      "summary": "A gas burner. The air collar sets the flame: closed gives a yellow safety flame, open gives a hot roaring blue flame.",
      "safeUse": [
        "Tie back long hair, wear goggles, and stand the burner on a heat-proof mat away from paper.",
        "Close the air collar before you light it.",
        "Have the lit splint or lighter ready over the barrel before you turn the gas on, then light it at once.",
        "Open the collar for a hot blue flame only while you are heating something.",
        "When you are not heating, close the collar to the yellow safety flame so everyone can see it.",
        "Turn the gas off at the tap when you finish."
      ],
      "mistakes": [
        {
          "id": "gas-unlit",
          "when": "The gas tap has been on for more than 2 seconds with no flame.",
          "say": "Gas is on but not lit. Turn the gas tap off now, then light it the right way."
        },
        {
          "id": "light-collar-open",
          "when": "Someone tried to light it with the air collar open, and the gas is still on.",
          "say": "It will not light with the collar open. Turn the gas off, close the collar, then try again."
        },
        {
          "id": "blue-flame-idle",
          "when": "A roaring blue flame has burned for over 20 seconds.",
          "say": "A blue flame is hard to see. If you are not heating, close the collar to the yellow safety flame."
        }
      ],
      "hazards": [
        "Unburnt gas can build up and explode.",
        "A blue flame is almost invisible in daylight.",
        "The barrel stays hot after the flame is out.",
