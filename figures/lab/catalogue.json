      "id": "bench-power-supply",
      "kind": "lab",
      "name": "Bench power supply",
      "page": "public/figures/lab/bench-power-supply.html",
      "lab": "electronics",
      "summary": "A 0-30 V, 0-5 A bench supply. It holds the voltage you set (CV) until the load wants more than the current limit, then it holds the current (CC).",
      "safeUse": [
        "Turn the output off before you connect or change anything.",
        "Set the voltage first, then set the current limit a little above what your circuit should draw.",
        "Use red for + and black for -; green is mains earth, not the negative output.",
        "If the CC lamp lights when you did not expect it, something draws too much: turn off and check the circuit.",
        "Never short the output with the current limit turned up."
      ],
      "mistakes": [
        {
          "id": "short-high-limit",
          "when": "The output is on into a short with the current limit above 1 A.",
          "say": "That is a short with the current limit turned up. Turn the output off and turn the current limit down."
        },
        {
          "id": "resistor-overload",
          "when": "The resistor on the output burns more power than its rating.",
          "say": "The resistor is burning more than its rating and will overheat. Lower the voltage or use a bigger resistor."
        },
        {
          "id": "limit-at-max",
          "when": "The output is on into a load with the current limit at the 5 A maximum.",
          "say": "The current limit is at maximum, so it protects nothing. Set it just above what the circuit needs."
        }
      ],
      "hazards": [
        "A short or a wrong connection can burn parts and wires.",
        "Overloaded resistors get hot enough to burn fingers.",
        "The mains inside the case is dangerous: never open it while plugged in."
      ],
