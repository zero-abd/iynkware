              "from_rating": "breakdown_voltage",
              "pick": "value"
            },
            "is_amps": {
              "from_rating": "saturation_current",
              "pick": "value"
            },
            "n": {
              "value": 1.5,
              "rationale": {
                "en": "Ideality factor chosen with the saturation current for a 0.7 V forward drop at 50 mA."
              },
              "source": {
                "src": "datasheet",
                "loc": "forward voltage 1.2 V max at 200 mA"
              }
            },
            "rs_ohms": {
              "from_rating": "dynamic_resistance",
              "pick": "value"
            },
            "imax_amps": {
