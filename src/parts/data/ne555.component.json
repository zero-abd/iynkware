      "measure": "ratio",
      "role": "threshold",
      "description": {
        "en": "THRES trips at two thirds and TRIG at one third of the CONT voltage, which is the supply when CONT is open."
      },
      "used_by_model": "none",
      "manufacturer": {
        "unit": "1",
        "value": 0.6667,
        "source": {
          "src": "datasheet",
          "loc": "electrical characteristics, THRES and TRIG voltage levels"
        }
      },
      "scope": {
        "part": true
      }
    }
