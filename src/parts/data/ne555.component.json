    "output_high_drop": {
      "measure": "voltage",
      "role": "characteristic",
      "description": {
        "en": "Drop of the output below the supply when high. Fitted to 13.3 V at 15 V and 100 mA and 12.5 V at 200 mA."
      },
      "used_by_model": "simulation",
      "simulation": {
        "unit": "V",
        "value": 0.7,
        "derived_from": [
          "output_resistance.simulation"
        ],
        "rationale": {
          "en": "A 0.7 V drop plus 10 ohm times the current reproduces 13.3 V at 100 mA and 12.5 V at 200 mA (15 V supply) to 0.2 V."
        },
        "confidence": "medium",
        "source": {
          "src": "datasheet",
          "loc": "electrical characteristics, high-level output voltage"
        }
      },
      "scope": {
        "pins": [
          "OUT"
        ]
      },
      "primary": true
    },
    "output_resistance": {
      "measure": "resistance",
      "role": "characteristic",
      "description": {
        "en": "Output resistance, high and low."
      },
      "used_by_model": "simulation",
      "simulation": {
        "unit": "ohm",
        "value": 10,
        "rationale": {
          "en": "Output low is 0.1 V at 10 mA and 0.4 V at 50 mA at 15 V, about 8 ohm; 10 ohm is used. At 100 mA the sheet's 2 V low level is higher than the model gives."
        },
        "confidence": "medium",
        "source": {
          "src": "datasheet",
          "loc": "electrical characteristics, low-level output voltage"
        }
      },
      "scope": {
        "pins": [
          "OUT"
        ]
      },
      "primary": true
    },
    "discharge_resistance": {
      "measure": "resistance",
      "role": "characteristic",
      "description": {
        "en": "On-resistance of the discharge transistor: 0.15 V at 8 mA."
      },
      "used_by_model": "simulation",
      "simulation": {
        "unit": "ohm",
        "value": 19,
        "rationale": {
          "en": "0.15 V divided by 8 mA is 19 ohm (5 V supply)."
        },
        "confidence": "medium",
        "source": {
          "src": "datasheet",
          "loc": "electrical characteristics, DISCH switch on-state voltage"
        }
      },
      "scope": {
        "pins": [
          "DISCH"
        ]
      },
      "primary": true
    },
    "supply_current": {
      "measure": "current",
      "role": "consumption",
      "description": {
        "en": "Supply current at 5 V, no load: 3 mA output low, 2 mA output high."
      },
      "used_by_model": "simulation",
      "simulation": {
        "unit": "A",
        "value": 0.003,
        "rationale": {
          "en": "The output-low value at 5 V; the real current rises to 10 mA at 15 V and one number is used."
        },
        "confidence": "medium",
        "source": {
          "src": "datasheet",
          "loc": "electrical characteristics, supply current"
        }
      },
      "scope": {
        "pins": [
          "VCC"
        ]
      }
    },
