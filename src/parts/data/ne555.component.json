  "simulation": {
    "tier": "T0",
    "status": "modelled",
    "what_it_models": [
      {
        "en": "The latch, the two comparators at one third and two thirds of the control voltage, the reset pin and the discharge transistor."
      },
      {
        "en": "An output that sits 0.7 V plus 10 ohm times the current below the supply when high."
      }
    ],
    "not_modelled": [
      {
        "en": "Propagation delay and the supply current spike at each output change."
      },
      {
        "en": "Threshold and trigger tolerance: the comparators trip at one third and two thirds with no spread."
      },
      {
        "en": "Output swing under heavy load: low level is 1 V at 100 mA in the model and 2 V on the sheet."
      }
    ],
    "validity": [
