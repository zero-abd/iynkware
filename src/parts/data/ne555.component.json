  "behaviour": {
    "summary": {
      "en": "A bipolar 555 timer: the trigger pin below one third of the supply sets the output high, the threshold pin above two thirds sets it low and turns the discharge transistor on."
    },
    "layers": [
      {
        "id": "timer",
        "domain": "analog",
        "reads": [
          "TRIG",
          "THRES",
          "CONT",
          "RESET"
        ],
        "summary": {
          "en": "The latch, the two comparators and the discharge transistor."
        },
        "model": {
          "kind": "element",
          "element": "timer_555",
          "terminals": {
            "gnd": "GND",
            "trig": "TRIG",
            "out": "OUT",
            "reset": "RESET",
            "ctrl": "CONT",
            "thr": "THRES",
            "dis": "DISCH",
            "vcc": "VCC"
          },
          "params": {
            "r_out_ohms": {
              "from_rating": "output_resistance",
              "pick": "value"
            },
            "high_drop_volts": {
              "from_rating": "output_high_drop",
              "pick": "value"
            },
            "dis_on_ohms": {
              "from_rating": "discharge_resistance",
              "pick": "value"
            },
            "quiescent_amps": {
              "from_rating": "supply_current",
              "pick": "value"
            },
            "supply_max_volts": {
              "from_rating": "supply_voltage_max",
              "pick": "value"
            },
            "output_max_amps": {
              "from_rating": "output_current_max",
              "pick": "value"
            }
          }
        }
      }
    ]
  },
  "failure_modes": [
    {
      "id": "supply_over",
      "name": {
        "en": "Burned out by too high a supply"
      },
      "cause_id": "x-555-overvoltage",
      "symptom_ids": [
        "part-dead"
      ],
      "when": [
        {
          "measure": "pin_voltage",
          "target": "VCC",
          "op": ">",
          "threshold": {
            "rating": "supply_voltage_max",
            "pick": "value"
          }
        }
      ],
      "effect": {
        "state": "burnt",
        "latched": true,
        "recovers_when": "the part is replaced"
      },
      "derivation": {
        "en": "Above 18 V the sheet allows no operation and the part can be destroyed."
      },
      "basis": "manufacturer",
      "implemented_as": "threshold",
      "source": {
        "src": "datasheet",
        "loc": "absolute maximum ratings"
      }
    },
    {
      "id": "output_overcurrent",
      "name": {
        "en": "Burned out by too much output current"
      },
      "cause_id": "x-555-output-overcurrent",
      "symptom_ids": [
        "part-dead"
      ],
      "when": [
        {
          "measure": "pin_current_peak",
          "target": "OUT",
          "op": ">",
          "threshold": {
            "rating": "output_current_max",
            "pick": "value"
          }
        }
      ],
      "effect": {
        "state": "burnt",
        "latched": true,
        "recovers_when": "the part is replaced"
      },
      "derivation": {
        "en": "An output asked for more than 225 mA overheats the output stage."
      },
      "basis": "manufacturer",
      "implemented_as": "threshold",
      "source": {
        "src": "datasheet",
        "loc": "absolute maximum ratings, IO"
      }
    }
