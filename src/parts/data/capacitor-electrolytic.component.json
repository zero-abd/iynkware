  "behaviour": {
    "summary": {
      "en": "A polarised capacitor: the plus lead must stay at the higher voltage. It fails if the voltage reverses or passes its rating."
    },
    "layers": [
      {
        "id": "dc",
        "domain": "analog",
        "reads": [
          "PLUS",
          "MINUS",
          "farads",
          "rated_volts"
        ],
        "summary": {
          "en": "Polarised capacitor with a series resistance, plus on the first pin."
        },
        "model": {
          "kind": "element",
          "element": "capacitor",
          "terminals": {
            "a": "PLUS",
            "b": "MINUS"
          },
          "params": {
            "farads": {
              "value": 0.0001,
              "rationale": {
                "en": "Default only. The placed value comes from the farads parameter."
              },
              "unit": "F",
              "source": {
                "src": "figurejs",
                "loc": "figures/parts/capacitor-electrolytic.js"
              }
            },
            "esr_ohms": {
              "from_rating": "esr",
              "pick": "value"
            },
            "polarized": {
              "value": true,
              "rationale": {
                "en": "An aluminium electrolytic is polarised."
              },
              "source": {
                "src": "figurejs",
                "loc": "figures/parts/capacitor-electrolytic.js"
              }
            },
            "rated_volts": {
              "from_rating": "rated_voltage",
              "pick": "value"
            }
          }
        }
      }
    ]
  },
  "failure_modes": [
    {
      "id": "overvoltage",
      "name": {
        "en": "Vented by too much voltage"
      },
      "cause_id": "x-electrolytic-overvoltage",
      "symptom_ids": [
        "part-dead"
      ],
      "when": [
        {
          "measure": "pin_voltage",
          "target": "PLUS",
          "op": ">",
          "threshold": {
            "rating": "rated_voltage",
            "pick": "value"
          }
        }
      ],
      "effect": {
        "state": "burnt",
        "latched": true,
        "recovers_when": "the part is replaced"
      },
      "derivation": {
        "en": "Above the rated voltage the oxide layer breaks down, the cell heats and the vent opens."
      },
      "basis": "simulation-assumption",
      "implemented_as": "threshold",
      "source": {
        "src": "factsheet",
        "loc": "section 4"
      }
    },
    {
      "id": "reversed",
      "name": {
        "en": "Vented by a reversed voltage"
      },
      "cause_id": "x-electrolytic-reversed",
      "symptom_ids": [
        "part-dead"
      ],
      "when": [
        {
          "measure": "pin_voltage_reverse",
          "target": "PLUS",
          "op": ">",
          "threshold": {
            "rating": "reverse_voltage",
            "pick": "value"
          }
        }
      ],
      "effect": {
        "state": "burnt",
        "latched": true,
        "recovers_when": "the part is replaced"
      },
      "derivation": {
        "en": "More than about 1 V the wrong way round drives gas out of the can and vents it."
      },
      "basis": "simulation-assumption",
      "implemented_as": "threshold",
      "source": {
        "src": "factsheet",
        "loc": "section 4"
      }
    }
