  "simulation": {
    "tier": "T0",
    "status": "modelled",
    "what_it_models": [
      {
        "en": "Two amplifiers with 100 000 gain, a 0.7 MHz gain-bandwidth, a 0.3 V per microsecond slew rate and an output 1.5 V inside the supply."
      }
    ],
    "not_modelled": [
      {
        "en": "Input offset, bias current and common-mode range: the inputs are ideal."
      },
      {
        "en": "Crossover distortion of the output stage and the low-side swing to 20 mV of the negative rail."
      },
      {
        "en": "Channel separation and supply rejection."
      },
      {
        "en": "The output current limit near 40 mA: a short to ground draws what the output resistance allows, and above 60 mA for 100 ms the part is marked burnt, where the sheet allows a short to ground at 15 V or less."
      }
    ],
    "validity": [
      {
        "measure": "supply voltage",
        "min": 3,
        "max": 32,
        "unit": "V"
      }
    ],
    "known_gaps": [
      {
        "id": "ideal_inputs",
        "text": {
          "en": "No input bias or offset, so a circuit near ground reads cleaner than the real part."
        }
      }
    ],
