  "failure_modes": [
    {
      "id": "supply_over",
      "name": {
        "en": "Burned out by too high a supply"
      },
      "cause_id": "x-opamp-overvoltage",
      "symptom_ids": [
        "part-dead"
      ],
      "when": [
        {
          "measure": "pin_voltage",
          "target": "VCC",
          "op": ">",
          "threshold": {
            "rating": "supply_voltage_max",
            "pick": "value"
          }
        }
      ],
      "effect": {
        "state": "burnt",
        "latched": true,
        "recovers_when": "the part is replaced"
      },
      "derivation": {
        "en": "Above 32 V between the supply pins the sheet allows no operation and the part can be destroyed."
      },
      "basis": "manufacturer",
      "implemented_as": "threshold",
      "source": {
        "src": "datasheet",
        "loc": "absolute maximum ratings"
      }
    },
    {
      "id": "output_short",
      "name": {
        "en": "Burned out by an output short"
      },
      "cause_id": "x-opamp-output-short",
      "symptom_ids": [
        "part-dead"
      ],
      "when": [
        {
          "measure": "pin_current_peak",
          "target": "OUT1",
          "op": ">",
          "threshold": {
            "rating": "output_short_current",
            "pick": "max"
          }
        }
      ],
      "effect": {
        "state": "burnt",
        "latched": true,
        "recovers_when": "the part is replaced"
      },
      "derivation": {
        "en": "An output asked for more than its 60 mA maximum short circuit current overheats the output stage."
      },
      "basis": "manufacturer",
      "implemented_as": "threshold",
      "source": {
        "src": "datasheet",
        "loc": "electrical characteristics, ISC"
      }
    }
  ],
